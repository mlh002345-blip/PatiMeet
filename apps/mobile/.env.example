# PatiMeet mobil uygulama ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın.

# ---------------------------------------------------------------------------
# API adresi
# ---------------------------------------------------------------------------
# - Boş bırakılırsa: Expo geliştirme sunucusunun ana makine IP'si kullanılır
#   (gerçek cihazda localhost telefonun kendisini gösterdiği için gerekli).
# - Yayın derlemelerinde bu değeri mutlaka ayarlayın.
#
# EXPO_PUBLIC_ ön eki, değerin istemci paketine dahil edilmesini sağlar;
# bu yüzden buraya gizli bilgi yazmayın.
EXPO_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Google ile giriş
# ---------------------------------------------------------------------------
# Her platform Google Cloud Console'da AYRI bir OAuth istemcisi gerektirir.
# Bir platformun kimliği tanımlı değilse, o platformda "Google ile devam et"
# düğmesi hiç gösterilmez (uygulama çalışmaya devam eder, e-posta ile giriş
# kullanılır).
#
# Bu kimlikler gizli değildir; uygulama paketine gömülürler. "Client secret"
# mobil akışta kullanılmaz — asla buraya yazmayın.
#
# iOS istemcisi: Application type = iOS, Bundle ID = com.patimeet.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android istemcisi: Application type = Android, Package name = com.patimeet.app
# ve imzalama sertifikanızın SHA-1 parmak izi gerekir.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web istemcisi: yalnızca `npx expo start --web` önizlemesi için gerekli.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# NOT: iOS'ta Google'ın geri dönüş şeması ("ters çevrilmiş istemci kimliği")
# app.config.ts tarafından EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID değerinden
# otomatik üretilir; elle eklemeniz gerekmez.
#
# NOT: Bu değişkenler derleme anında paketlenir. Değiştirdikten sonra
# `npx expo start --clear` ile önbelleği temizleyin ve yeni bir derleme alın.

# ---------------------------------------------------------------------------
# Apple ile Giriş
# ---------------------------------------------------------------------------
# İstemci tarafında ayrı bir anahtar GEREKMEZ. Yetkilendirme yerel iOS
# bileşeniyle yapılır; kimlik doğrulama sunucuda bundle identifier'a göre
# yürür (bkz. apps/api/.env.example → APPLE_BUNDLE_ID).
#
# Gerekli olan tek şey Apple Developer hesabında yapılandırmadır:
#   1. Identifiers > App ID (com.patimeet.app) > "Sign In with Apple" özelliğini aç
#   2. Uygulama `app.json` içinde `ios.usesAppleSignIn: true` ile derlenir
#      (bu depoda zaten ayarlı)
# Simülatörde çalışır ancak gerçek bir Apple Kimliği ile test etmek gerekir.

# ---------------------------------------------------------------------------
# Push bildirimleri
# ---------------------------------------------------------------------------
# İstemcide ek değişken gerekmez; cihaz jetonu EAS proje kimliğine göre
# üretilir ve `eas init` sonrası app.json içindeki `extra.eas.projectId`
# alanına yazılır.
#
# Gerekli tek seferlik kurulum:
#   iOS     → EAS, APNs anahtarını sizin için yönetir (eas credentials)
#   Android → Firebase projesinden FCM V1 servis hesabı anahtarı EAS'a
#             yüklenir (eas credentials). Bu olmadan Android'e bildirim gitmez.
#
# Push jetonu yalnızca GERÇEK CİHAZDA üretilir; simülatör/emülatörde
# uygulama bildirim olmadan sorunsuz çalışır.
