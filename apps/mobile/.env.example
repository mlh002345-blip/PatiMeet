# PatiMeet mobil uygulama ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın.

# API adresi.
# - Boş bırakılırsa: Expo geliştirme sunucusunun ana makine IP'si kullanılır
#   (gerçek cihazda localhost telefonun kendisini gösterdiği için gerekli).
# - Yayın derlemelerinde bu değeri mutlaka ayarlayın.
#
# EXPO_PUBLIC_ ön eki, değerin istemci paketine dahil edilmesini sağlar;
# bu yüzden buraya gizli bilgi yazmayın.
EXPO_PUBLIC_API_URL=
