{
  "expo": {
    "name": "PatiMeet",
    "slug": "patimeet",
    "version": "1.0.0",
    "scheme": "patimeet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16281F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patimeet.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Profil ve köpek fotoğrafınızı seçebilmeniz için fotoğraf galerinize erişim izni gerekiyor.",
        "NSCameraUsageDescription": "Profil ve köpek fotoğrafınızı çekebilmeniz için kamera izni gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Yürüyüş rotanızı, mesafenizi ve temponuzu hesaplayabilmek için yalnızca yürüyüş sırasında konumunuza erişiyoruz."
      }
    },
    "android": {
      "package": "com.patimeet.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#16281F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil ve köpek fotoğrafınızı seçebilmeniz için fotoğraf galerinize erişim izni gerekiyor.",
          "cameraPermission": "Profil ve köpek fotoğrafınızı çekebilmeniz için kamera izni gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#A6602F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yürüyüş rotanızı, mesafenizi ve temponuzu hesaplayabilmek için yalnızca yürüyüş sırasında konumunuza erişiyoruz.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://patimeet-githup-production.up.railway.app",
      "eas": {
        "projectId": "1089a8fd-73f6-4c3b-a91f-ed4dd05f1d0b"
      }
    },
    "owner": "mlhoznnn"
  }
}
