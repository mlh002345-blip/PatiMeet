# PatiMeet API ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.

# Sunucu
PORT=4000
HOST=0.0.0.0

# Oturum imzalama anahtarı.
# ÖNEMLİ: Production'da rastgele ve uzun bir değer zorunludur (örn. `openssl rand -hex 32`).
# Ayarlanmazsa NODE_ENV=production altında sunucu açılmaz.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Veritabanı dosyası (SQLite)
DB_FILE=./data/patimeet.sqlite

# Moderasyon uçlarına erişim anahtarı (/api/admin/*).
# Production'da zorunludur; kullanıcı pasife alma, etkinlik kaldırma ve
# şikâyet inceleme işlemleri bu anahtarla yapılır.
ADMIN_TOKEN=

# CORS. Yayında mobil uygulama dışındaki kaynakları kısıtlamak için
# tam adres verin; geliştirmede * yeterlidir.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Google ile giriş
# ---------------------------------------------------------------------------
# Sunucu, mobil uygulamadan gelen Google ID token'ının imzasını doğrular ve
# token'ın `aud` (audience) alanının aşağıdaki istemci kimliklerinden biri
# olmasını şart koşar. Bu yüzden uygulamanın kullandığı HER platformun istemci
# kimliği burada tanımlı olmalıdır.
#
# Bu değerler gizli değildir (OAuth istemci kimlikleri herkese açıktır).
# GİZLİ olan "client secret" bu akışta hiç kullanılmaz — mobil uygulama PKCE
# ile çalışır, bu yüzden sunucuya client secret koymayın.
#
# Hiçbiri tanımlı değilse Google ile giriş kapalıdır: sunucu 503
# `google_not_configured` döner ve uygulamada Google düğmesi görünmez.
#
# Google Cloud Console → APIs & Services → Credentials üzerinden alınır.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Alternatif: hepsini virgülle ayırarak tek değişkende verebilirsiniz.
# GOOGLE_CLIENT_IDS=123-ios.apps.googleusercontent.com,456-android.apps.googleusercontent.com
