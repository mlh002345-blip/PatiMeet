# PatiMeet API ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.

# Sunucu
PORT=4000
HOST=0.0.0.0

# Oturum imzalama anahtarı.
# ÖNEMLİ: Production'da rastgele ve uzun bir değer zorunludur (örn. `openssl rand -hex 32`).
# Ayarlanmazsa NODE_ENV=production altında sunucu açılmaz.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Veritabanı dosyası (SQLite)
DB_FILE=./data/patimeet.sqlite

# Moderasyon uçlarına erişim anahtarı (/api/admin/*).
# Production'da zorunludur; kullanıcı pasife alma, etkinlik kaldırma ve
# şikâyet inceleme işlemleri bu anahtarla yapılır.
ADMIN_TOKEN=

# CORS. Yayında mobil uygulama dışındaki kaynakları kısıtlamak için
# tam adres verin; geliştirmede * yeterlidir.
CORS_ORIGIN=*
