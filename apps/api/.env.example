# PatiMeet API ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# Geliştirmede tümü boş bırakılabilir; production'da (*) işaretliler zorunludur.

# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Ters vekil (Fly, Render, Railway, nginx) arkasındaysanız gerçek istemci IP'si
# için gerekli. Production'da varsayılan olarak açıktır.
TRUST_PROXY=

# Günlük seviyesi: debug | info | warn | error | silent
LOG_LEVEL=

# ---------------------------------------------------------------------------
# Veritabanı (*)
# ---------------------------------------------------------------------------
# Yönetilen PostgreSQL bağlantı adresi. BOŞ BIRAKILIRSA gömülü PostgreSQL
# (PGlite) kullanılır — yalnızca geliştirme için. Production'da ZORUNLUDUR.
#
# Örnekler:
#   Neon      postgresql://kullanici:sifre@ep-xxx.eu-central-1.aws.neon.tech/patimeet?sslmode=require
#   Supabase  postgresql://postgres:sifre@db.xxx.supabase.co:5432/postgres
#   RDS       postgresql://patimeet:sifre@xxx.eu-central-1.rds.amazonaws.com:5432/patimeet
DATABASE_URL=

# Bağlantı havuzu boyutu. Sunucusuz/havuzlanmış bağlantı (Neon pooler,
# Supabase pgbouncer) kullanıyorsanız düşük tutun.
DATABASE_POOL_SIZE=10

# Sunucu açılışında bekleyen migration'ları uygula. Birden fazla örnek
# çalıştırıyorsanız `false` yapıp deployment adımında `npm run migrate` çalıştırın.
MIGRATE_ON_BOOT=true

# Gömülü PostgreSQL verisinin yazılacağı dizin (yalnızca DATABASE_URL boşken).
# `memory` verilirse bellekte tutulur ve süreç kapanınca kaybolur.
PGLITE_DATA_DIR=

# ---------------------------------------------------------------------------
# Oturum ve yönetim anahtarları (*)
# ---------------------------------------------------------------------------
# Kullanıcı oturum jetonlarını imzalar. Üretin: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Moderasyon paneli oturum çerezini imzalar. Üretin: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=28800

# Makineden makineye moderasyon API'si (`x-admin-token` başlığı).
# Üretin: openssl rand -hex 32
ADMIN_TOKEN=

# İlk yönetici hesabını oluşturmak için (tek seferlik). Panel açıldıktan sonra
# bu iki değişkeni kaldırabilirsiniz. Alternatif: npm run create-admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Obje depolama — profil ve köpek fotoğrafları (*)
# ---------------------------------------------------------------------------
# s3    : S3 uyumlu depo (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# local : dosya sistemi — YALNIZCA geliştirme (birden fazla sunucuda paylaşılmaz)
STORAGE_DRIVER=local

S3_BUCKET=
S3_REGION=auto
# AWS S3 için boş bırakın. R2/B2/MinIO için servis uç adresi:
#   R2   https://<hesap-id>.r2.cloudflarestorage.com
#   B2   https://s3.eu-central-003.backblazeb2.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Görsellerin sunulduğu genel adres (CDN). Verilirse kalıcı adres üretilir.
# BOŞ BIRAKILIRSA kova özel kalabilir ve süreli imzalı adres üretilir (önerilir).
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL=3600

# Yükleme üst sınırı (bayt). Varsayılan 5 MB.
MAX_UPLOAD_BYTES=5242880

# Geliştirmede yerel dosyaların yazılacağı dizin.
STORAGE_LOCAL_DIR=

# ---------------------------------------------------------------------------
# Google ile Giriş
# ---------------------------------------------------------------------------
# Google Cloud Console > Kimlik Bilgileri'nden OAuth istemci kimlikleri.
# Hepsi boş bırakılırsa Google ile giriş kapalı olur ve istemcide düğme
# gösterilmez. `client secret` kullanılmaz (mobilde PKCE).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Alternatif: virgülle ayrılmış tek liste
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Apple ile Giriş (iOS mağaza gönderimi için zorunlu)
# ---------------------------------------------------------------------------
# Native uygulamada kimlik token'ının `aud` alanı bundle identifier'dır.
APPLE_BUNDLE_ID=com.patimeet.app
# Web akışı eklenirse Apple Developer'daki Services ID.
APPLE_SERVICES_ID=
# Alternatif: virgülle ayrılmış tek liste
APPLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Push bildirimleri
# ---------------------------------------------------------------------------
# expo : Expo Push API (tek uçtan iOS + Android)
# none : gönderim kapalı; cihaz jetonları yine kaydedilir
PUSH_DRIVER=expo

# Expo hesabınızda "Enhanced Security for Push Notifications" açıksa zorunlu.
# Oluşturma: expo.dev > Account Settings > Access Tokens
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Ağ ve hız sınırı
# ---------------------------------------------------------------------------
# Yayında mobil uygulama dışındaki kaynakları kısıtlamak için tam adres verin.
CORS_ORIGIN=*

RATE_LIMIT_ENABLED=true
# Genel API penceresi
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Kimlik uçları (kaba kuvvete karşı daha sıkı)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Yazma işlemleri (mesaj, etkinlik, şikâyet, yükleme)
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60

# ---------------------------------------------------------------------------
# Yayın adresleri (mağaza formları ve yasal metinler)
# ---------------------------------------------------------------------------
PUBLIC_WEB_URL=https://patimeet.app
SUPPORT_EMAIL=destek@patimeet.app

# ---------------------------------------------------------------------------
# Testler
# ---------------------------------------------------------------------------
# Verilirse testler gerçek PostgreSQL'e bağlanır; böylece production sürücüsü
# (`pg`) de aynı testlerle doğrulanır. Boşken gömülü PostgreSQL kullanılır.
# UYARI: verdiğiniz veritabanı test sırasında değiştirilir; ayrı bir veritabanı
# kullanın.
TEST_DATABASE_URL=
