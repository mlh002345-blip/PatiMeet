{
  "name": "@patimeet/api",
  "version": "0.1.0",
  "private": true,
  "description": "PatiMeet MVP backend — REST API for the iOS/Android app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/smoke-test.ts",
    "test:google": "tsx src/google-test.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "test:platform": "tsx src/platform-test.ts",
    "test:all": "npm run test && npm run test:google && npm run test:platform && npm run test:matching && npm run test:alerts && npm run test:product",
    "test:matching": "tsx src/matching-test.ts",
    "test:alerts": "tsx src/alerts-test.ts",
    "test:product": "tsx src/product-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@electric-sql/pglite": "^0.5.5",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.9",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.15.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
